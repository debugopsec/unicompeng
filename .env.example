# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# One or more chat IDs, comma-separated (for example: -1001234567890)
TELEGRAM_CHAT_IDS=

# raw = copy forwarded announcements exactly, preserving formatting (default)
# extract = split announcements into categorized tasks
WATCHER_MODE=raw

# Optional AI extraction. Any OpenAI-compatible API works.
# Leave LLM_API_KEY empty to use simple keyword rules instead.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Optional comma-separated names or terms to redact from public task text
PII_REDACT_TERMS=
